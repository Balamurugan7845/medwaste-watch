APP_NAME="MedWaste Watch"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-RENDER-BACKEND.onrender.com
APP_TIMEZONE=Asia/Kolkata

DB_HOST=YOUR_TIDB_HOST
DB_PORT=4000
DB_DATABASE=medwaste_db
DB_USERNAME=YOUR_TIDB_USERNAME
DB_PASSWORD=YOUR_TIDB_PASSWORD
DB_CHARSET=utf8mb4

SESSION_LIFETIME=7200
CSRF_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ALLOWED_ORIGIN=https://medwaste-watch-frontend.vercel.app

EXPIRY_URGENT_DAYS=7
EXPIRY_WARNING_DAYS=30
RESERVATION_TIMEOUT_HOURS=24
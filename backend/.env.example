# MedWaste Watch — Environment Configuration
# Duplicate this file as .env and adjust credentials

APP_NAME="MedWaste Watch"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medwaste_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_CHARSET=utf8mb4
DB_SSL_CA=

# Security & Session
SESSION_LIFETIME=7200
CSRF_SECRET=generate_a_long_random_secret_for_this_environment
CORS_ALLOWED_ORIGIN=http://localhost:8000

# Hospital Inventory Business Defaults
EXPIRY_URGENT_DAYS=7
EXPIRY_WARNING_DAYS=30
RESERVATION_TIMEOUT_HOURS=24
